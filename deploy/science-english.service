[Unit]
Description=Science English
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/opt/science-english
Environment=PYTHONUNBUFFERED=1
# optional: SEED_ADMIN_PASSWORD=change-me
ExecStart=/opt/science-english/.venv/bin/python /opt/science-english/manage.py serve --port 8013
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/science-english

[Install]
WantedBy=multi-user.target
